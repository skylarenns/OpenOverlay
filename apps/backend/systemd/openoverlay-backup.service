[Unit]
Description=Create and verify an OpenOverlay backup
After=Openoverlaybackend.service

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=-/etc/openoverlay-backup.env
ExecStart=/usr/local/sbin/openoverlay-backup-runner
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/backups/openoverlay /var/lib/openoverlay
ReadOnlyPaths=/usr/local/libexec/openoverlay
