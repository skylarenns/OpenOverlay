{
  "name": "openoverlay",
  "version": "0.1.0",
  "private": true,
  "description": "OpenOverlay livestream graphics monorepo.",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @openoverlay/backend & npm run dev --workspace @openoverlay/frontend",
    "deploy:backend": "bash scripts/deploy-backend.sh",
    "build": "npm run build --workspace @openoverlay/shared && npm run build --workspace @openoverlay/backend && npm run build --workspace @openoverlay/frontend",
    "test": "npm run build --workspace @openoverlay/shared && npm run test --workspaces --if-present",
    "test:backend": "npm run test --workspace @openoverlay/backend",
    "test:e2e": "npm run test:e2e --workspace @openoverlay/frontend",
    "typecheck": "npm run build --workspace @openoverlay/shared && npm run typecheck --workspace @openoverlay/backend && npm run typecheck --workspace @openoverlay/frontend",
    "validate:config": "node scripts/validate-deployment-config.mjs",
    "check:deployments": "node scripts/check-deployment-sync.mjs",
    "backup:verify": "node scripts/openoverlay-backup.mjs verify",
    "media:audit": "node scripts/openoverlay-backup.mjs media-audit",
    "restore:verify": "node scripts/openoverlay-backup.mjs restore-verify",
    "lint": "eslint apps packages",
    "format:check": "prettier --check .",
    "coverage": "npm run test --workspaces --if-present -- --coverage",
    "seed": "npm run seed --workspace @openoverlay/backend"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=10.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.1",
    "@eslint/js": "10.0.1",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "9.39.2",
    "eslint-plugin-react-hooks": "7.0.1",
    "prettier": "3.8.1",
    "typescript-eslint": "8.52.0"
  }
}
